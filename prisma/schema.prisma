generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyLogs DailyLog[]
}

model DailyLog {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  // Today's class
  classAttended Boolean @default(false)

  // Mathematics
  mathRevision     Boolean @default(false)
  mathRevisionNote String?

  mathHomework     Boolean @default(false)
  mathHomeworkNote String?

  mathDoubt     Boolean @default(false)
  mathDoubtNote String?

  // Physics
  physicsRevision     Boolean @default(false)
  physicsRevisionNote String?

  physicsHomework     Boolean @default(false)
  physicsHomeworkNote String?

  physicsDoubt     Boolean @default(false)
  physicsDoubtNote String?

  // Chemistry
  chemistryRevision     Boolean @default(false)
  chemistryRevisionNote String?

  chemistryHomework     Boolean @default(false)
  chemistryHomeworkNote String?

  chemistryDoubt     Boolean @default(false)
  chemistryDoubtNote String?

  // Submission
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  proofOfWork ProofOfWork[]

  @@unique([userId, date])
  @@index([userId, date])
}

model ProofOfWork {
  id         String @id @default(cuid())
  dailyLogId String

  url       String
  publicId  String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
}
